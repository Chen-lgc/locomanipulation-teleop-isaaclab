            apiSchemas = ["MaterialBindingAPI", "MjcImageableAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/base_link/VisualMaterials/gray>
            int mjc:group = 1
        }

        def Scope "VisualMaterials"
        {
            def Material "gray" (
