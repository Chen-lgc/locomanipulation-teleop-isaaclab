                    }

                    over "RR_thigh_joint" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                    }
                }

                over "RR_hip_joint" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }

            over "piperx_mount"
            {
                over "link1"
                {
                    over "link2"
                    {
                        over "link3"
                        {
