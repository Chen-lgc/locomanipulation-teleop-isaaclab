#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    defaultPrim = "a2_piper_x"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "a2_piper_x" (
